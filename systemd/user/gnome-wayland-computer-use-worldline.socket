[Unit]
Description=GWCU WORLDLINE revision socket
PartOf=graphical-session.target

[Socket]
ListenStream=%t/gnome-wayland-computer-use/worldline.sock
DirectoryMode=0700
SocketMode=0600
RemoveOnStop=true
Service=gnome-wayland-computer-use-worldline.service

[Install]
WantedBy=graphical-session.target
